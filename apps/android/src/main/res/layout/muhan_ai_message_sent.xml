<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/muhan_ai_message_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/conversation_item_background"
    android:paddingTop="@dimen/conversation_vertical_message_spacing_collapse"
    android:paddingBottom="@dimen/conversation_vertical_message_spacing_collapse"
    android:clipToPadding="false"
    android:clipChildren="false">

    <LinearLayout
        android:id="@+id/muhan_ai_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true"
        android:layout_marginLeft="@dimen/message_bubble_edge_margin"
        android:layout_marginStart="@dimen/message_bubble_edge_margin"
        android:layout_marginRight="12dp"
        android:layout_marginEnd="12dp"
        android:orientation="vertical"
        android:background="@drawable/message_bubble_background_sent_alone"
        android:clipToPadding="false"
        android:clipChildren="false">

        <!-- Nova Chat: attachment previews (image thumbnail / audio player), hidden for text-only -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/muhan_ai_message_image"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/message_bubble_horizontal_padding"
            android:layout_marginStart="@dimen/message_bubble_horizontal_padding"
            android:layout_marginRight="@dimen/message_bubble_horizontal_padding"
            android:layout_marginEnd="@dimen/message_bubble_horizontal_padding"
            android:layout_marginTop="@dimen/message_bubble_top_padding"
            android:adjustViewBounds="true"
            android:maxHeight="280dp"
            android:minHeight="80dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            tools:ignore="ContentDescription" />

        <LinearLayout
            android:id="@+id/muhan_ai_message_audio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/message_bubble_horizontal_padding"
            android:layout_marginStart="@dimen/message_bubble_horizontal_padding"
            android:layout_marginRight="@dimen/message_bubble_horizontal_padding"
            android:layout_marginEnd="@dimen/message_bubble_horizontal_padding"
            android:layout_marginTop="@dimen/message_bubble_top_padding"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/muhan_ai_message_audio_play"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/circle_touch_highlight_background"
                android:contentDescription="@string/muhan_ai_audio_play"
                android:scaleType="fitCenter"
                android:src="@drawable/play_icon"
                android:tint="?conversation_item_outgoing_text_primary_color" />

            <TextView
                android:id="@+id/muhan_ai_message_audio_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginStart="8dp"
                android:alpha="0.85"
                android:textSize="13sp"
                tools:text="0:12" />

        </LinearLayout>

        <TextView
            android:id="@+id/muhan_ai_message_text"
            style="@style/Signal.Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/message_bubble_horizontal_padding"
            android:layout_marginStart="@dimen/message_bubble_horizontal_padding"
            android:layout_marginRight="@dimen/message_bubble_horizontal_padding"
            android:layout_marginEnd="@dimen/message_bubble_horizontal_padding"
            android:paddingTop="@dimen/message_bubble_top_padding"
            android:autoLink="web"
            android:textColorLink="?attr/colorAccent"
            android:textIsSelectable="true"
            tools:text="你好！" />

        <TextView
            android:id="@+id/muhan_ai_message_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginLeft="@dimen/message_bubble_horizontal_padding"
            android:layout_marginStart="@dimen/message_bubble_horizontal_padding"
            android:layout_marginRight="@dimen/message_bubble_horizontal_padding"
            android:layout_marginEnd="@dimen/message_bubble_horizontal_padding"
            android:layout_marginBottom="@dimen/message_bubble_bottom_padding"
            android:alpha="0.7"
            android:textSize="12sp"
            tools:text="12:34" />

    </LinearLayout>

</RelativeLayout>