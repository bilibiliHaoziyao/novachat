<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/muhan_ai_message_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/conversation_item_background"
    android:paddingTop="@dimen/conversation_vertical_message_spacing_collapse"
    android:paddingBottom="@dimen/conversation_vertical_message_spacing_collapse"
    android:clipToPadding="false"
    android:clipChildren="false">

    <LinearLayout
        android:id="@+id/muhan_ai_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true"
        android:layout_marginLeft="@dimen/message_bubble_edge_margin"
        android:layout_marginStart="@dimen/message_bubble_edge_margin"
        android:layout_marginRight="12dp"
        android:layout_marginEnd="12dp"
        android:orientation="vertical"
        android:background="@drawable/message_bubble_background_sent_alone"
        android:clipToPadding="false"
        android:clipChildren="false">

        <TextView
            android:id="@+id/muhan_ai_message_text"
            style="@style/Signal.Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/message_bubble_horizontal_padding"
            android:layout_marginStart="@dimen/message_bubble_horizontal_padding"
            android:layout_marginRight="@dimen/message_bubble_horizontal_padding"
            android:layout_marginEnd="@dimen/message_bubble_horizontal_padding"
            android:paddingTop="@dimen/message_bubble_top_padding"
            android:autoLink="web"
            android:textColorLink="?attr/colorAccent"
            android:textIsSelectable="true"
            tools:text="你好！" />

        <TextView
            android:id="@+id/muhan_ai_message_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginLeft="@dimen/message_bubble_horizontal_padding"
            android:layout_marginStart="@dimen/message_bubble_horizontal_padding"
            android:layout_marginRight="@dimen/message_bubble_horizontal_padding"
            android:layout_marginEnd="@dimen/message_bubble_horizontal_padding"
            android:layout_marginBottom="@dimen/message_bubble_bottom_padding"
            android:alpha="0.7"
            android:textSize="12sp"
            tools:text="12:34" />

    </LinearLayout>

</RelativeLayout>