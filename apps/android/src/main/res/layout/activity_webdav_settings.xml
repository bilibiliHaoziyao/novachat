<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- extends the toolbar color behind the status bar (edge-to-edge) -->
    <include layout="@layout/status_bar_background" />

    <ScrollView
        android:id="@+id/webdav_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

        <TextView
            android:id="@+id/webdav_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/webdav_url_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="@string/webdav_server_url_hint"
            android:inputType="textUri"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/webdav_username_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="@string/webdav_username"
            android:inputType="text"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/webdav_password_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="@string/webdav_password"
            android:inputType="textPassword"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/webdav_passphrase_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:hint="@string/webdav_backup_passphrase"
            android:inputType="textPassword"
            android:importantForAutofill="no" />

        <Button
            android:id="@+id/webdav_backup_button"
            style="@style/ButtonPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/webdav_backup_now" />

        <Button
            android:id="@+id/webdav_restore_button"
            style="@style/ButtonSecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/webdav_restore_now" />

        </LinearLayout>

    </ScrollView>

</FrameLayout>
